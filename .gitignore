# MHS Live or Die - Files to Exclude from Git

# Git LFS now handles all MP4 files
# All videos will be stored in Git LFS

# Exclude only non-video large files
Gears*.mp4
official*.mp4
*.mov
*.avi
*.mkv
*.webm

# Exclude large audio files
*.mp3
*.wav
*.ogg

# Exclude large bitmap images
*.bmp

# Exclude extremely large video files (over 100MB)
# Netlify free tier has 100MB per file limit
Gears 5 Montage.mp4
official trailer.mp4

# Backup files
*.bak
*-old.*
*-backup.*

# System files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Node modules (if you add any build tools later)
node_modules/
