# MHS Live or Die - Files to Exclude from Git

# Exclude large video files (over 50MB)
# Small videos under 50MB can be included for auto-deploy
# *.mp4
# *.mov
# *.avi
# *.mkv
# *.webm

# Exclude specific large videos
74.mp4
Battlefield*.mp4
Gears*.mp4
official*.mp4
*.mov
*.avi
*.mkv
*.webm

# Exclude large audio files
*.mp3
*.wav
*.ogg

# Exclude large bitmap images
*.bmp

# Exclude extremely large video files (over 100MB)
# Netlify free tier has 100MB per file limit
Gears 5 Montage.mp4
official trailer.mp4

# Backup files
*.bak
*-old.*
*-backup.*

# System files
.DS_Store
Thumbs.db
desktop.ini

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Node modules (if you add any build tools later)
node_modules/
